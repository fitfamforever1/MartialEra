function clear(p: player):
    send "&c[Casting] Sequence expired" to {_p}
    delete data tag "casting:sequence" of {_p}
    delete data tag "casting:timer" of {_p}

function clearlater(p: player):
    wait 5 seconds
    if data tag "casting:sequence" of {_p} is set:
        send "&c[Casting] Sequence expired" to {_p}
        delete data tag "casting:sequence" of {_p}

function cast(p: player):
    set {_seq} to data tag "casting:sequence" of {_p}
    send "&6[Casting] Cast spell: &b%{_seq}%" to {_p}
    
on right click:
    set {_seq} to data tag "casting:sequence" of player

    if {_seq} is not set:
        set data tag "casting:sequence" of player to "R"
        send action bar "&b[Casting] &7R" to player

        clearlater(player)

    else if size of {_seq} < 7:
        add(player, "R")

    else:
        cast(player)
        clear(player)

on left click on air:
    set {_seq} to data tag "casting:sequence" of player

    if {_seq} is set:
        if size of {_seq} < 7:
            add(player, "L")
        else:
            cast(player)
            clear(player)
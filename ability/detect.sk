on right click:
    set {_seq} to data tag "casting:sequence" of player
    set {_timeout} to data tag "casting:timeout" of player
    
    # Start new sequence if none exists
    if {_seq} is not set:
        set data tag "casting:sequence" of player to "R"
        send action bar "&b[Casting] &7R" to player
        
        # Cancel existing timeout if any
        if {_timeout} is set:
            cancel task {_timeout}
        
        # Set 3 second timeout and store task ID
        set {_task} to (delay 3 seconds: clear-sequence(player))
        set data tag "casting:timeout" of player to {_task}
    
    # Add to existing sequence if not full (max 4 inputs = "R L L L")
    else if length of {_seq} < 7:
        set {_seq} to {_seq} + " R"
        set data tag "casting:sequence" of player to {_seq}
        send action bar "&b[Casting] &7%{_seq}%" to player
        
        # Check if sequence is complete (4 inputs)
        if length of {_seq} == 7:
            cast-spell(player, {_seq})
            clear-sequence(player)
    
    # Sequence full - cast the spell
    else:
        cast-spell(player, {_seq})
        clear-sequence(player)
    
    cancel event

on left click:
    set {_seq} to data tag "casting:sequence" of player
    
    # Only accept if sequence exists and not full
    if {_seq} is set and length of {_seq} < 7:
        set {_seq} to {_seq} + " L"
        set data tag "casting:sequence" of player to {_seq}
        send action bar "&b[Casting] &7%{_seq}%" to player
        
        # Check if sequence is complete (4 inputs)
        if length of {_seq} == 7:
            cast-spell(player, {_seq})
            clear-sequence(player)
        
        cancel event

function clear-sequence(p: player):
    message "&c[Casting] Sequence expired" to {p}
    delete data tag "casting:sequence" of {p}
    delete data tag "casting:timeout" of {p}

function cast-spell(p: player, sequence: string):
    delete data tag "casting:timeout" of {p}
    message "&6[Casting] Cast spell: &b%{sequence}%" to {p}
    
    # Spell mapping - add your spells here!
    # Example:
    # if {sequence} == "R L":
    #     apply potion of fire_resistance to {p}
    # else if {sequence} == "R L L":
    #     strike {p} with lightning
    # else if {sequence} == "R L R":
    #     push {p} upwards with force 2
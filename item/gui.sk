function craftgui(p: player):
    set {_gui} to chest inventory with 3 rows named "<##E9BF35>ꜰᴏʀɢɪɴɢ ɢᴜɪ"

    loop 27 times:
        set slot (loop-number - 1) of {_gui} to {item::space}
        
    set slot 10 of {_gui} to air
    set slot 12 of {_gui} to air
    set slot 14 of {_gui} to {item::craft}
    set slot 16 of {_gui} to air

    open {_gui} to {_p}
    
on inventory click:
    name of event-inventory is "<##E9BF35>ꜰᴏʀɢɪɴɢ ɢᴜɪ"
    if event-slot is 14:
        cancel event
        
        set {_temp1} to item in slot 10 of event-inventory
        set {_temp2} to item in slot 12 of event-inventory
        set {_type1} to data tag "itemstat:type" of {_temp1}
        set {_type2} to data tag "itemstat:type" of {_temp2}
        if all:
            {_type1} is "ore"
            {_type2} is "ore"
        then:
            set {_temp3} to item in slot 16 of event-inventory
            if {_temp3} is not air:
                give {_temp3} to player
            set {_type3} to number data tag "itemstat:min" of {_temp2}
            set {_type4} to number data tag "itemstat:max" of {_temp1}
            send "%{_type3}% | %{_type4}%"
            set {_item} to sword({_type3}, {_type4})
            remove 1 of {_temp1} from event-inventory 
            remove 1 of {_temp2} from event-inventory
            set slot 16 of event-inventory to {_item}
        else:
            send "&cInvalid"

    if event-slot is 10 or 12 or 16:
        set {_cursor} to cursor slot of player
        if {_cursor} is not air:
            if event-slot is 16:
                cancel event
            else:
                set {_type} to data tag "itemstat:type" of {_cursor}
                if {_type} is not "ore":
                    cancel event

    set {_temp} to data tag "item:id" of event-item
    if {_temp} is "1":
        cancel event

on inventory close:
    name of event-inventory is "<##E9BF35>ꜰᴏʀɢɪɴɢ ɢᴜɪ"
    set {_temp1} to item in slot 10 of event-inventory
    set {_temp2} to item in slot 12 of event-inventory
    set {_temp3} to item in slot 16 of event-inventory

    if {_temp1} is not air:
        give {_temp1} to player
    if {_temp2} is not air:
        give {_temp2} to player
    if {_temp3} is not air:
        give {_temp3} to player
    
function craft2gui(p: player):
    set {_gui} to chest inventory with 3 rows named "<##E9BF35>ꜱᴇʟᴇᴄᴛ ꜰᴏʀɢɪɴɢ ɪᴛᴇᴍ"

    loop 27 times:
        set slot (loop-number - 1) of {_gui} to {item::space}
        
    set slot 10 of {_gui} to {item::craft1}
    set slot 11 of {_gui} to {item::craft2}
    set slot 13 of {_gui} to {item::craft3}
    set slot 14 of {_gui} to {item::craft4}
    set slot 15 of {_gui} to {item::craft5}
    set slot 16 of {_gui} to {item::craft6}

    open {_gui} to {_p}
    
command /test1:
    trigger:
        craft2gui(player)
        
command /test2:
    trigger:
        set {_item} to player's tool
        set {_type} to data tag "itemstat:type" of {_item}
        set {_type2} to number data tag "itemstat:min" of {_item}
        set {_type3} to number data tag "itemstat:max" of {_item}
        send "%{_type}% | %{_min}%/%{_max}%"
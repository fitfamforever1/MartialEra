on break of large amethyst bud:
    clear drops
    set {_loc} to location of event-block
    set {_bx} to x-coordinate of event-block
    set {_bz} to z-coordinate of event-block
    set {_absX} to abs({_bx})
    set {_absZ} to abs({_bz})
    set {_dist} to max({_absX}, {_absZ})
    set {_maxDist} to 1024
    if {_dist} > {_maxDist}:
        set {_dist} to {_maxDist}
    set {_level} to 18 - floor(({_dist} / {_maxDist}) * 17)
    if {_level} < 1:
        set {_level} to 1
    else if {_level} > 18:
        set {_level} to 18
    if chance of 40%:
        set {_item} to material({_level})
        give {_item} to player

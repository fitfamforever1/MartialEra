function openOre(p: player):
    set {_gui} to chest inventory with 4 rows named "<##E9BF35>ꜰᴏʀɢɪɴɢ ɢᴜɪ"

    loop 36 times:
        set slot (loop-number - 1) of {_gui} to {item::space}
        
    open {_gui} to {_p}
    
on inventory click:
    name of event-inventory is "<##E9BF35>ꜰᴏʀɢɪɴɢ ɢᴜɪ"
    set {_temp} to data tag "item:id" of event-item
    if {_temp} is "1":
        cancel event
        stop
    
command /test:
    trigger:
        openOre(player)
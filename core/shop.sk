command /saveitem <text>:
    permission: admin.save
    trigger:
        if player's tool is air:
            send "&cYou're not holding anything!" to player
            stop
        set {item::%arg-1%} to player's tool
        send "&aSaved item as &e%arg-1%" to player

command /giveitem <text>:
    permission: admin.save
    trigger:
        if {item::%arg-1%} is set:
            give {item::%arg-1%} to player
            send "&aGave you item &e%arg-1%" to player
        else:
            send "&cNo item found with id &e%arg-1%" to player
            
command /pdcset [<text>] [<text>]:
    permission: admin.create
    trigger:
        set {_item} to player's held item
        set {_key} to arg-1
        set {_val} to arg-2
        set data tag {_key} of {_item} to {_val}
        set player's held item to {_item}
        send "&aSet &e%{_key}% &a= &e%{_val}%&a on held item."

function item(base: item, buy: number, sell: number):: item:
    set {_item} to {_base}
    set {_p} to SmallCaps("%{_base}%")
    set name of {_item} to "&f%{_p}%"

    set data tag "item:sale" of {_item} to true
    set string data tag "item:id" of {_item} to "%type of {_base}%"
    set number data tag "item:buy" of {_item} to {_buy}
    set number data tag "item:sell" of {_item} to {_sell}

    set line 1 of lore of {_item} to "&8┃ &7» ꜱᴀʟᴇ ɪɴꜰᴏ"
    set line 2 of lore of {_item} to "&8┃ &7ʙᴜʏ ᴘʀɪᴄᴇ &8» &e%{_buy}%"
    set line 3 of lore of {_item} to "&8┃ &7ꜱᴇʟʟ ᴘʀɪᴄᴇ &8» &e%{_sell}%"

    return {_item}


function buyItem(p: player, item: item, amount: number):
    set {_id} to string data tag "item:id" of {_item}
    set {_price} to (number data tag "item:buy" of {_item}) * {_amount}
    set {_bal} to number data tag "money:amm" of {_p}

    if {_bal} < {_price}:
        send "&cYou don't have enough money!" to {_p}
        stop

    remove {_price} from {_bal}
    set number data tag "money:amm" of {_p} to {_bal}

    give {_amount} of {_id} parsed as item to {_p}

function sellItem(p: player, item: item, amount: number):
    set {_id} to string data tag "item:id" of {_item}
    set {_price} to (number data tag "item:sell" of {_item}) * {_amount}

    if {_p} doesn't have {_amount} of {_id} parsed as item:
        send "&cYou don't have enough items!" to {_p}
        stop

    remove {_amount} of {_id} parsed as item from {_p}

    set {_bal} to number data tag "money:amm" of {_p}
    add {_price} to {_bal}
    set number data tag "money:amm" of {_p} to {_bal}

    
function openOre(p: player):
    set {_gui} to chest inventory with 3 rows named "<##E9BF35>ᴏʀᴇ ꜱʜᴏᴘ"

    loop 27 times:
        set slot (loop-number - 1) of {_gui} to {item::space}
    
    set slot 10 of {_gui} to item(netherite_ingot, 10, 10)
    set slot 11 of {_gui} to item(emerald, 10, 10)
    set slot 12 of {_gui} to item(diamond, 10, 10)
    set slot 13 of {_gui} to item(gold_ingot, 10, 10)
    set slot 14 of {_gui} to item(iron_ingot, 10, 10)
    set slot 15 of {_gui} to item(copper_ingot, 10, 10)
    set slot 16 of {_gui} to item(coal, 10, 10)
        
    open {_gui} to {_p}
    
on inventory click:
    if name of event-inventory is "<##E9BF35>ᴏʀᴇ ꜱʜᴏᴘ":
        cancel event

        if data tag "item:sale" of event-item is not true:
            stop

        if click type is left mouse button:
            buyItem(player, event-item, 1)

        else if click type is left mouse button with shift:
            buyItem(player, event-item, 64)

        else if click type is right mouse button:
            sellItem(player, event-item, 1)

        else if click type is right mouse button with shift:
            sellItem(player, event-item, 64)

        else if click type is middle mouse:
            set {_id} to string data tag "item:id" of event-item
            set {_mat} to {_id} parsed as item

            set {_amount} to amount of {_mat} in player's inventory

            if {_amount} > 0:
                sellItem(player, event-item, {_amount})
            else:
                send "&cYou don't have any to sell!"

    
command /test:
    trigger:
        openOre(player)
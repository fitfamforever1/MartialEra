########################################
# Dynamic Shop - Skript
# Stock-based pricing: price rises as stock falls below equilibrium,
# and falls as stock rises above it.
########################################

on script load:
    # tuning knobs
    set {shop::sensitivity} to 0.5     # how aggressively price reacts to stock changes
    set {shop::minmult} to 0.25        # price never drops below 25% of base
    set {shop::maxmult} to 4           # price never exceeds 400% of base
    set {shop::sellmargin} to 0.85     # currentbuy = currentsell * this (keeps a spread)
    set {shop::maxtransaction} to 6400 # hard cap on amount per single buy/sell call
    set {shop::guisize} to 54          # GUI inventory size (must be multiple of 9)


########################################
# 1. GENERATOR
########################################

# Registers a single item into the shop with its starting values.
function createShopItem(item: text, stock: number, basebuy: number, basesell: number):
    add {_item} to {shop::items::*}
    set {shop::stock::%{_item}%} to {_stock}
    set {shop::defaultstock::%{_item}%} to {_stock}
    set {shop::basebuy::%{_item}%} to {_basebuy}
    set {shop::basesell::%{_item}%} to {_basesell}
    updateShopPrices({_item})

# Convenience helper: sets up a small sample catalog for testing.
# Call this once (e.g. via /shopgen) to populate the shop.
function generateShopItems():
    createShopItem("DIAMOND", 64, 50, 60)
    createShopItem("IRON_INGOT", 128, 5, 8)
    createShopItem("EMERALD", 32, 40, 50)
    createShopItem("GOLD_INGOT", 96, 10, 14)


########################################
# 2. PRICE CALCULATION
########################################

# Pure calculation: returns what the sell price WOULD be at a given
# hypothetical stock level, without touching any stored values.
# Used both for the live price and for simulating per-unit price shifts.
function calcSellPrice(item: text, stock: number) :: number:
    set {_default} to {shop::defaultstock::%{_item}%}
    set {_base} to {shop::basesell::%{_item}%}

    # ratio > 0 when stock is scarce (below default), < 0 when oversupplied
    set {_ratio} to ({_default} - {_stock}) / {_default}
    set {_price} to {_base} + ({_ratio} * {_base} * {shop::sensitivity})

    # clamp between min/max multiplier of base sell price
    set {_min} to {_base} * {shop::minmult}
    set {_max} to {_base} * {shop::maxmult}
    if {_price} < {_min}:
        set {_price} to {_min}
    else if {_price} > {_max}:
        set {_price} to {_max}

    return {_price}

# Recomputes and stores the live current buy/sell for an item based on
# its ACTUAL current stock. Called automatically after every buy/sell.
function updateShopPrices(item: text):
    set {_newsell} to calcSellPrice({_item}, {shop::stock::%{_item}%})
    set {shop::currentsell::%{_item}%} to {_newsell}
    set {shop::currentbuy::%{_item}%} to {_newsell} * {shop::sellmargin}


########################################
# 3. BUY / SELL
########################################

# Player buys FROM the shop (spends money, stock goes down, price rises).
# Each unit is priced against the stock level AFTER the previous units in
# this same purchase were accounted for, so buying e.g. 5 at once costs
# progressively more per unit than buying 1 at a time, five times.
function shopBuyItem(p: player, item: text, amount: number) :: boolean:
    if {shop::items::*} does not contain {_item}:
        send "&cThat item isn't sold here." to {_p}
        return false

    if {_amount} > {shop::maxtransaction}:
        send "&cYou can only buy up to %{shop::maxtransaction}% at once." to {_p}
        return false

    if {shop::stock::%{_item}%} < {_amount}:
        send "&cNot enough stock (only %{shop::stock::%{_item}%}% left)." to {_p}
        return false

    set {_itemtype} to {_item} parsed as item type
    if {_itemtype} is not set:
        send "&cInvalid item: %{_item}%." to {_p}
        return false

    # simulate the transaction unit-by-unit to get the true marginal cost
    set {_simstock} to {shop::stock::%{_item}%}
    set {_totalcost} to 0
    loop {_amount} times:
        add calcSellPrice({_item}, {_simstock}) to {_totalcost}
        remove 1 from {_simstock}

    set {_senderBal} to number data tag "money:amm" of {_p}
    if {_senderBal} < {_totalcost}:
        send "&cYou need %{_totalcost}% but only have %{_senderBal}%." to {_p}
        return false

    set number data tag "money:amm" of {_p} to {_senderBal} - {_totalcost}
    set {shop::stock::%{_item}%} to {_simstock}
    updateShopPrices({_item})
    give ({_amount} of {_itemtype}) to {_p}

    send "&aBought %{_amount}%x %{_item}% for &f%{_totalcost}%&a." to {_p}
    return true

# Player sells TO the shop (earns money, stock goes up, price falls).
# Same per-unit simulation as buying, in reverse: each unit sold pushes the
# simulated stock up, so later units in a bulk sale earn progressively less.
function shopSellItem(p: player, item: text, amount: number) :: boolean:
    if {shop::items::*} does not contain {_item}:
        send "&cThat item isn't accepted here." to {_p}
        return false

    if {_amount} > {shop::maxtransaction}:
        send "&cYou can only sell up to %{shop::maxtransaction}% at once." to {_p}
        return false

    set {_itemtype} to {_item} parsed as item type
    if {_itemtype} is not set:
        send "&cInvalid item: %{_item}%." to {_p}
        return false

    if {_p} does not have ({_amount} of {_itemtype}):
        send "&cYou don't have %{_amount}%x %{_item}%." to {_p}
        return false

    set {_simstock} to {shop::stock::%{_item}%}
    set {_totalearn} to 0
    loop {_amount} times:
        add (calcSellPrice({_item}, {_simstock}) * {shop::sellmargin}) to {_totalearn}
        add 1 to {_simstock}

    set {_senderBal} to number data tag "money:amm" of {_p}
    set number data tag "money:amm" of {_p} to {_senderBal} + {_totalearn}
    set {shop::stock::%{_item}%} to {_simstock}
    updateShopPrices({_item})
    remove ({_amount} of {_itemtype}) from {_p}'s inventory

    send "&aSold %{_amount}%x %{_item}% for &f%{_totalearn}%&a." to {_p}
    return true


########################################
# 4. STATUS CHECK
########################################

function shopStatus(p: player, item: text):
    if {shop::items::*} does not contain {_item}:
        send "&cThat item isn't sold here." to {_p}
        stop

    send "&6--- %{_item}% ---" to {_p}
    send "&7Stock: &f%{shop::stock::%{_item}%}% &7(default: %{shop::defaultstock::%{_item}%}%)" to {_p}
    send "&7Base Buy: &f%{shop::basebuy::%{_item}%}% &7| Base Sell: &f%{shop::basesell::%{_item}%}%" to {_p}
    send "&7Current Buy: &a%{shop::currentbuy::%{_item}%}% &7| Current Sell: &c%{shop::currentsell::%{_item}%}%" to {_p}


########################################
# 5. TEMP GUI (fixed 4-item test layout - replace with your own)
########################################

# Builds a single display item (icon + live lore) for a shop entry.
function buildShopItemStack(item: text) :: itemtype:
    set {_type} to {_item} parsed as item type
    if {_type} is not set:
        return air

    set {_stack} to 1 of {_type}
    set the name of {_stack} to "&e%{_item}%"
    set the lore of {_stack} to "&7Stock: &f%{shop::stock::%{_item}%}%&7/&f%{shop::defaultstock::%{_item}%}%" and " " and "&aLeft-click&7: buy 1 for &f%{shop::currentsell::%{_item}%}%" and "&cRight-click&7: sell 1 for &f%{shop::currentbuy::%{_item}%}%"
    return {_stack}

# Opens the temp test GUI with the 4 sample items in fixed slots.
function openShopGUI(p: player):
    set {_inv} to chest inventory with 1 rows named "&8Shop (temp)"
    set {shop::guiinv::%{_p}%} to {_inv}
    delete {shop::guislot::%{_p}%::*}

    set slot 2 of {_inv} to buildShopItemStack("DIAMOND")
    set {shop::guislot::%{_p}%::2} to "DIAMOND"
    set slot 3 of {_inv} to buildShopItemStack("IRON_INGOT")
    set {shop::guislot::%{_p}%::3} to "IRON_INGOT"
    set slot 4 of {_inv} to buildShopItemStack("EMERALD")
    set {shop::guislot::%{_p}%::4} to "EMERALD"
    set slot 5 of {_inv} to buildShopItemStack("GOLD_INGOT")
    set {shop::guislot::%{_p}%::5} to "GOLD_INGOT"

    open {_inv} to {_p}

# Re-stamps lore on the currently open GUI in place after a transaction.
function refreshShopGUI(p: player):
    if {shop::guiinv::%{_p}%} is not set:
        stop
    set {_inv} to {shop::guiinv::%{_p}%}
    loop {shop::guislot::%{_p}%::*}:
        set {_key} to loop-value
        set {_slotnum} to (loop-index parsed as integer)
        set slot {_slotnum} of {_inv} to buildShopItemStack({_key})

on inventory click:
    if {shop::guiinv::%player%} is not set:
        stop
    if event-inventory is not {shop::guiinv::%player%}:
        stop
    cancel event

    if {_slot} >= 9:
        stop # click landed in the player's own inventory, ignore

    set {_key} to {shop::guislot::%player%::%{_slot}%}
    if {_key} is not set:
        stop # empty slot

    if click type = left click:
        shopBuyItem(player, {_key}, 1)
        refreshShopGUI(player)
    else if click type = right click:
        shopSellItem(player, {_key}, 1)
        refreshShopGUI(player)

on inventory close:
    if {shop::guiinv::%player%} is set:
        if event-inventory is {shop::guiinv::%player%}:
            delete {shop::guiinv::%player%}
            delete {shop::guislot::%player%::*}


########################################
# 6. TEMP TEST COMMANDS
########################################

command /shop:
    trigger:
        openShopGUI(player)

command /shopgen:
    trigger:
        generateShopItems()
        send "&aShop generated with sample items (DIAMOND, IRON_INGOT, EMERALD, GOLD_INGOT)." to player

command /shopbuy <text> <number>:
    trigger:
        shopBuyItem(player, arg-1, arg-2)

command /shopsell <text> <number>:
    trigger:
        shopSellItem(player, arg-1, arg-2)

command /shopstatus <text>:
    trigger:
        shopStatus(player, arg-1)

command /shopbalance:
    trigger:
        send "&7Balance: &f%number data tag "money:amm" of player%" to player

command /shoplist:
    trigger:
        send "&6Items: &f%{shop::items::*}%" to player
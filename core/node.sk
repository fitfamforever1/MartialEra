function pasteNode(loc: location):
    loop 3 times:
        set {_b} to block at {_loc}
        set {_b} to oak log
        set block data of {_b} to "axis=x"
        add 1 to y-coordinate of {_loc}

command /nodepaste <number>:
    permission: admin.node
    trigger:
        set {_loc} to player's location
        add 1 to x-coord of {_loc}
        pasteNode({_loc})
        
        
function pasteNode1(loc: location):
    loop 3 times:
        set block data of block at {_loc} to oak_log[axis=x]
        add 1 to x-coordinate of {_loc}
        
function pasteNode2(loc: location):
    set {_l} to {_loc}
    set block at {_l} to cobblestone
    add 1 to x-coordinate of {_l}
    set block at {_l} to stone
    add 1 to x-coordinate of {_l}
    set block at {_l} to stone
    add 1 to x-coordinate of {_l}
    set block at {_l} to stone_slab[type=bottom]

    set {_l} to {_loc}
    add 1 to x-coordinate of {_l}
    remove 1 from z-coordinate of {_l}
    set block at {_l} to stone
    add 1 to x-coordinate of {_l}
    set block at {_l} to cobblestone_slab[type=bottom]

    set {_l} to {_loc}
    add 1 to x-coordinate of {_l}
    add 1 to z-coordinate of {_l}
    set block at {_l} to stone
    add 1 to x-coordinate of {_l}
    set block at {_l} to cobblestone

    set {_l} to {_loc}
    add 1 to x-coordinate of {_l}
    add 1 to y-coordinate of {_l}
    set block at {_l} to stone_slab[type=bottom]
    add 1 to x-coordinate of {_l}
    set block at {_l} to stone_slab[type=bottom]
        
command /nodepaste <number>:
    permission: admin.node
    trigger:
        set {_loc} to player's location
        add 1 to x-coord of {_loc}
        pasteNode2({_loc})
        
        
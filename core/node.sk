function canPasteNode(loc: location, id: number) :: boolean:
    set {_blocks::*} to {_loc}

    if {_id} > 1:
        set {_l} to {_loc}
        add 1 to x-coordinate of {_l}
        add {_l} to {_blocks::*}

        add 1 to x-coordinate of {_l}
        add {_l} to {_blocks::*}

        add 1 to x-coordinate of {_l}
        add {_l} to {_blocks::*}

        set {_l} to {_loc}
        add 1 to x-coordinate of {_l}
        remove 1 from z-coordinate of {_l}
        add {_l} to {_blocks::*}

        add 1 to x-coordinate of {_l}
        add {_l} to {_blocks::*}

        set {_l} to {_loc}
        add 1 to x-coordinate of {_l}
        add 1 to z-coordinate of {_l}
        add {_l} to {_blocks::*}

        add 1 to x-coordinate of {_l}
        add {_l} to {_blocks::*}

        set {_l} to {_loc}
        add 1 to x-coordinate of {_l}
        add 1 to y-coordinate of {_l}
        add {_l} to {_blocks::*}

        add 1 to x-coordinate of {_l}
        add {_l} to {_blocks::*}
    else:
        set {_l} to {_loc}
        loop 2 times:
            add 1 to x-coordinate of {_l}
            add {_l} to {_blocks::*}

    loop {_blocks::*}:
        if block at loop-value is not air:
            return false

    return true

function registerNodeBlock(loc: location, nodeId: number, nodeType: number):
    set {node::id::%{_loc}%} to {_nodeId}
    set {node::type::%{_loc}%} to {_nodeType}
    add {_loc} to {node::blocks::%{_nodeId}%::*}
       
function pasteNode1(loc: location):
    add 1 to {lastNodeId}
    set {_nodeId} to {lastNodeId}

    loop 3 times:
        set block data of block at {_loc} to oak_log[axis=x]
        registerNodeBlock({_loc}, {_nodeId}, 1)
        add 1 to x-coordinate of {_loc}
        
function pasteNode2(loc: location):
    add 1 to {lastNodeId}
    set {_nodeId} to {lastNodeId}

    set {_l} to {_loc}
    set block at {_l} to cobblestone
    registerNodeBlock({_l}, {_nodeId}, 2)
    add 1 to x-coordinate of {_l}
    set block at {_l} to stone
    registerNodeBlock({_l}, {_nodeId}, 2)
    add 1 to x-coordinate of {_l}
    set block at {_l} to stone
    registerNodeBlock({_l}, {_nodeId}, 2)
    add 1 to x-coordinate of {_l}
    set block at {_l} to stone_slab[type=bottom]
    registerNodeBlock({_l}, {_nodeId}, 2)

    set {_l} to {_loc}
    add 1 to x-coordinate of {_l}
    remove 1 from z-coordinate of {_l}
    set block at {_l} to stone
    registerNodeBlock({_l}, {_nodeId}, 2)
    add 1 to x-coordinate of {_l}
    set block at {_l} to cobblestone_slab[type=bottom]
    registerNodeBlock({_l}, {_nodeId}, 2)

    set {_l} to {_loc}
    add 1 to x-coordinate of {_l}
    add 1 to z-coordinate of {_l}
    set block at {_l} to stone
    registerNodeBlock({_l}, {_nodeId}, 2)
    add 1 to x-coordinate of {_l}
    set block at {_l} to cobblestone
    registerNodeBlock({_l}, {_nodeId}, 2)

    set {_l} to {_loc}
    add 1 to x-coordinate of {_l}
    add 1 to y-coordinate of {_l}
    set block at {_l} to stone_slab[type=bottom]
    registerNodeBlock({_l}, {_nodeId}, 2)
    add 1 to x-coordinate of {_l}
    set block at {_l} to stone_slab[type=bottom]
    registerNodeBlock({_l}, {_nodeId}, 2)
    

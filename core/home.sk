command /sethome:
    trigger:
        set {_loc::x} to x-coord of player's location
        set {_loc::y} to y-coord of player's location
        set {_loc::z} to z-coord of player's location
        set {_loc::yaw} to yaw of player's location
        set {_loc::pitch} to pitch of player's location
        send "Home set at %{_loc::x}%, %{_loc::y}%, %{_loc::z}% %{_loc::yaw}% %{_loc::pitch}%"
command /sethome:
    trigger:
        set {_x} to x-coord of player's location
        set {_y} to y-coord of player's location
        set {_z} to z-coord of player's location
        set {_yaw} to yaw of player's location
        set {_pitch} to pitch of player's location
        send "Home set at %{_x}%, %{_y}%, %{_z}% %{_yaw}% %{_pitch}%"
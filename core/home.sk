command /sethome:
    trigger:
        set {_loc::1} to x-coord of player's location
        set {_loc::2} to y-coord of player's location
        set {_loc::3} to z-coord of player's location
        set {_loc::4} to yaw of player's location
        set {_loc::5} to pitch of player's location
        send "&8[<##54ab7a>ʜᴏᴍᴇ&8]&7 You have successfully set a home location."
        set number list data tag "home:loc" of player to {_loc::*}
        
command /home:
    trigger:
        set {_loc::*} to number list data tag "home:loc" of player
        if {_loc::1} is not set:
            send "&8[<##54ab7a>ʜᴏᴍᴇ&8]&c You haven't set a home yet."
            stop trigger
        set {_home} to location({_loc::1}, {_loc::2}, {_loc::3}, player's world, {_loc::4}, {_loc::5})
        teleport player to {_home}
        send "&8[<##54ab7a>ʜᴏᴍᴇ&8]&7 Teleported to your home."
        
command /delhome [<player>]:
    trigger:
        if arg-1 is set:
            if number list data tag "home:loc" of player is not set:
                send "&8[<##54ab7a>ʜᴏᴍᴇ&8]&c %arg-1% has no homes set."
                stop
            delete number list data tag "home:loc" of arg-1
            send "&8[<##54ab7a>ʜᴏᴍᴇ&8]&7 You have deleted&e %arg-1%&7's home."
            stop
        delete number list data tag "home:loc" of player
        send "&8[<##54ab7a>ʜᴏᴍᴇ&8]&7 You have deleted your home."
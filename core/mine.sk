################################################################
# Node mining animation — driven by the client's block-dig packet
#
# Assumes these already exist elsewhere in your scripts:
#   - locKey(location) :: text
#   - {node-lookup::%key%}          -> node id
#   - {nodes::%id%::type}           -> node type (1-4)
#   - getNodeDrop(type) :: itemtype
#   - destroyNode(id)               -> removes/respawns the node
#
# Requires: skript-reflect, skript-packet (recent build w/ client
# block-dig packet support)
################################################################

import:
    org.bukkit.GameMode


##### Per-type total break time, split across the 10 animation phases #####

function getPhaseDelay(type: integer) :: timespan:
    if {_type} = 1:
        return 1 second       # 10s total
    else if {_type} = 2:
        return 1.5 seconds    # 15s total
    else if {_type} = 3 or {_type} = 4:
        return 2 seconds      # 20s total
    return 1 second


##### Block stage tracking (persists so mining can pause/resume) #####

function getBlockStage(loc: location) :: integer:
    if {mining::stage::%{_loc}%} is set:
        return {mining::stage::%{_loc}%}
    return 0

function setBlockStage(loc: location, stage: integer):
    set {mining::stage::%{_loc}%} to {_stage}

function clearBlockStage(loc: location):
    delete {mining::stage::%{_loc}%}


##### Sending / clearing the break animation packet #####

function sendBlockDamage(p: player, loc: location, stage: integer):
    set {_id} to (({_loc}'s x + {_loc}'s y + {_loc}'s z) as integer)
    set {_packet} to new play_server_block_break_animation packet
    set field 0 of {_packet} to {_id}
    set field 1 of {_packet} to {_loc}   # auto-converted to BlockPosition
    set field 2 of {_packet} to {_stage}
    send packet {_packet} to {_p} without calling event

function clearBlockDamage(p: player, loc: location):
    sendBlockDamage({_p}, {_loc}, -1)    # -1 clears the crack overlay client-side


##### Finishing a node (shared by the animation and the fallback below) #####

function completeNode(p: player, nid: text, loc: location):
    delete {mining::active::%{_p}'s uuid%}
    delete {mining::phase::%{_p}'s uuid%}
    clearBlockStage({_loc})
    clearBlockDamage({_p}, {_loc})
    give getNodeDrop({nodes::%{_nid}%::type}) to {_p}
    destroyNode({_nid})


##### Start / stop digging #####

on packet event play_client_block_dig:
    set {_player} to event-player
    set {_loc} to field 0     # block position field, auto-converted to Location
    set {_status} to field 2  # EnumPlayerDigType field

    set {_key} to locKey({_loc})
    if {node-lookup::%{_key}%} is not set:
        stop # not a node block, let vanilla handling take it

    if {_player}'s gamemode is not survival:
        stop

    if "%{_status}%" is "START_DESTROY_BLOCK":
        set {mining::active::%{_player}'s uuid%} to true
        set {mining::node::%{_player}'s uuid%} to {node-lookup::%{_key}%}
        set {mining::loc::%{_player}'s uuid%} to {_loc}
        set {_type} to {nodes::%{node-lookup::%{_key}%}%::type}
        set {mining::delay::%{_player}'s uuid%} to getPhaseDelay({_type})
        # show current progress immediately, then arm the first phase timer
        sendBlockDamage({_player}, {_loc}, getBlockStage({_loc}))
        set {mining::phase::%{_player}'s uuid%} to now + {mining::delay::%{_player}'s uuid%}

    else if "%{_status}%" is "ABORT_DESTROYING_BLOCK" or "%{_status}%" is "STOP_DESTROYING_BLOCK":
        delete {mining::active::%{_player}'s uuid%}
        delete {mining::phase::%{_player}'s uuid%}
        # block stage is left in place on purpose, so mining resumes where it left off


##### Ticking active miners forward #####

every 1 tick:
    loop all players:
        set {_p} to loop-player
        if {mining::active::%{_p}'s uuid%} is not true:
            continue loop

        if {mining::phase::%{_p}'s uuid%} > now:
            continue loop # still mid-phase, nothing to do yet

        set {_loc} to {mining::loc::%{_p}'s uuid%}
        set {_nid} to {mining::node::%{_p}'s uuid%}
        set {_delay} to {mining::delay::%{_p}'s uuid%}

        set {_stage} to getBlockStage({_loc}) + 1

        if {_stage} >= 10:
            completeNode({_p}, {_nid}, {_loc})
        else:
            setBlockStage({_loc}, {_stage})
            sendBlockDamage({_p}, {_loc}, {_stage})
            set {mining::phase::%{_p}'s uuid%} to now + {_delay}


##### Fallback: catches any case the block still breaks the vanilla way #####

on break:
    set {_l} to location of event-block
    set {_key} to locKey({_l})
    if {node-lookup::%{_key}%} is set:
        set {_nid} to {node-lookup::%{_key}%}
        cancel event
        completeNode(player, {_nid}, {_l})
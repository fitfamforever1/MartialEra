function openRules(p: audience):
    open multi action dialog to {_p}:
        title: "ꜱᴇʀᴠᴇʀ ʀᴜʟᴇꜱ"
        can_close_with_escape: false
        columns: 1
        body:
            add plain message body:
                contents: mini message from "<dark_red><bold>ᴘʟᴇᴀꜱᴇ ʀᴇᴀᴅ ᴏᴜʀ ꜱᴇʀᴠᴇʀ ʀᴜles!"
            add plain message body:
                contents: mini message from "<gray><strikethrough>-------------------------"
            add plain message body:
                contents: mini message from "<green><bold>#1 <dark_gray>» <white>ɴᴏ ᴜɴꜰᴀɪʀ ᴀᴅᴠᴀɴᴛᴀɢᴇ."
            add plain message body:
                contents: mini message from "<green><bold>#2 <dark_gray>» <white>ɴᴏ ᴅᴜᴘʟɪᴄᴀᴛɪᴏɴ ɢʟɪᴛᴄʜᴇs."
            add plain message body:
                contents: mini message from "<green><bold>#3 <dark_gray>» <white>ɴᴏ ᴅᴏxxɪɴɢ ᴏʀ ʀᴇᴀʟ-ʟɪꜰᴇ ᴛʜʀᴇᴀᴛs."
            add plain message body:
                contents: mini message from "<green><bold>#4 <dark_gray>» <white>ɴᴏ sᴘᴀᴡɴ ᴄᴀᴍᴘɪɴɢ."
            add plain message body:
                contents: mini message from "<gray><strikethrough>-------------------------"
        actions:
            add callback action button:
                label: "Accept"
                trigger:
                    unfreeze connection event-playerconnection
            add callback action button:
                label: "Decline"
                trigger:
                    unfreeze connection event-playerconnection and disconnect due to mini message from "<red>Ok fine... bye!"
                    
command /test:
    trigger:
        openRules(player)
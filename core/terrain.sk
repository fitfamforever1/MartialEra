##########################################################################
# CAVEGEN — big-room Hypixel-style cave chunk generator + /cavegen
#
# REQUIRES:
#   - Skript
#   - SkBee            (chunk generator / world creator)  https://github.com/ShaneBeee/SkBee
#   - SkNoise 1.0+      (simplex noise "generator" objects) https://github.com/ReportCardsMC/SKNoise
#
# WHAT THIS DOES:
#   1. Registers a custom chunk generator ("cavegen") that fills a modest
#      vertical band with a mix of stone/andesite/cobblestone (no ores),
#      then uses 2D simplex noise to decide, per x/z column, whether that
#      whole column is a big open cavern (air, full height) or a solid
#      stone pillar/wall. This gives large walkable rooms instead of thin
#      worm-like tunnels.
#   2. Bedrock sits just below the floor, and a solid cap sits just above
#      the ceiling, so the cave always feels enclosed even in open rooms.
#   3. Creates/loads a dedicated world ("cavegen_world") using that generator.
#   4. Adds a /cavegen command that re-carves just the single chunk the
#      player is standing in, using the same noise algorithm.
#
# TUNING (search for "TUNE" below):
#   - {cavegen.freq}      -> lower = bigger, wider cave rooms. higher = smaller/mazier rooms
#   - {cavegen.threshold}  -> higher = more open space (bigger caves). lower = more solid stone
#   - {cavegen.floor} / {cavegen.ceiling} -> how tall the walkable cave band is
##########################################################################

on script load:
    # ---- tunables -------------------------------------------------------
    set {cavegen.freq} to 0.02             # TUNE: lower = bigger cave rooms
    set {cavegen.threshold} to 0.35         # TUNE: higher = bigger/more open caves
    set {cavegen.floor} to 55               # bottom of the walkable cave band
    set {cavegen.ceiling} to 70             # top of the walkable cave band (~15 blocks tall)
    set {cavegen.world} to "cavegen_world"

    # ---- noise generator (shared by world-gen AND the /cavegen command) -
    set {cavegen.noise} to new simplex generator with seed 918273645
    set frequency of {cavegen.noise} to {cavegen.freq}

    # ---- create/load the cave world if it doesn't exist yet -------------
    if world {cavegen.world} is not loaded:
        set {_w} to a world creator named {cavegen.world}
        set environment option of {_w} to normal
        set world type option of {_w} to normal
        set should generate structures option of {_w} to false
        set chunk generator of {_w} to chunk generator with id "cavegen"
        load world from creator {_w}
        send "&a[CaveGen] Cave world &f%{cavegen.world}%&a generated." to console

##########################################################################
# SHARED LOGIC
##########################################################################

# Decides whether a given x/z column is a big open cavern (true) or solid stone (false)
function cavegen_is_air(x: number, z: number) :: boolean:
    set {_raw} to value of {cavegen.noise} at {_x}, 0, {_z}
    set {_v} to abs({_raw})
    if {_v} < {cavegen.threshold}:
        return true
    return false

# Picks a random "no ores" mix for solid cave stone
function cavegen_block() :: blockdata:
    set {_r} to random integer between 1 and 100
    if {_r} <= 40:
        return stone[]
    else if {_r} <= 70:
        return andesite[]
    else:
        return cobblestone[]

##########################################################################
# CHUNK GENERATOR REGISTRATION (used for brand-new chunks in the world)
##########################################################################

register chunk generator with id "cavegen":

    noise gen:
        loop integers from 0 to 15:                       # local x  -> loop-number-1
            loop integers from 0 to 15:                   # local z  -> loop-number-2
                set {_lx} to loop-number-1
                set {_lz} to loop-number-2

                set {_wx} to {_lx} + (chunkdata chunk x * 16)
                set {_wz} to {_lz} + (chunkdata chunk z * 16)

                # bedrock safety layer under the floor (never exposed - floor row is always solid)
                set chunkdata block at vector({_lx}, {cavegen.floor} - 1, {_lz}) to bedrock

                set {_open} to cavegen_is_air({_wx}, {_wz})

                # floor row is ALWAYS solid so you always have ground to stand on
                set chunkdata block at vector({_lx}, {cavegen.floor}, {_lz}) to cavegen_block()

                # ceiling row is ALWAYS solid so open rooms still have rock overhead
                set chunkdata block at vector({_lx}, {cavegen.ceiling}, {_lz}) to cavegen_block()

                # everything between floor and ceiling is either hollowed (cave room) or solid stone
                loop integers from ({cavegen.floor} + 1) to ({cavegen.ceiling} - 1):
                    set {_y} to loop-number-3
                    if {_open} is true:
                        set chunkdata block at vector({_lx}, {_y}, {_lz}) to air
                    else:
                        set chunkdata block at vector({_lx}, {_y}, {_lz}) to cavegen_block()

    biome gen:
        # Closest vanilla biome to a hypixel-style mine/cavern
        set chunkdata biome to dripstone caves

##########################################################################
# /cavegen COMMAND — re-carves just the chunk the player is standing in
##########################################################################

command /cavegen:
    permission: cavegen.use
    permission message: &cYou don't have permission to use this command.
    trigger:
        if player is not in world {cavegen.world}:
            send "&cYou need to be in the cave world to use this. Teleporting you there now..." to player
            teleport player to location(x-coord of player, {cavegen.ceiling} + 2, z-coord of player, world {cavegen.world})
            wait 1 second

        send "&7[CaveGen] Regenerating this chunk, hold on..." to player

        set {_cx} to floor((x-coord of player) / 16)
        set {_cz} to floor((z-coord of player) / 16)
        set {_baseX} to {_cx} * 16
        set {_baseZ} to {_cz} * 16
        set {_w} to world {cavegen.world}

        # carve the cave band (same noise + block choice as world-gen)
        loop integers from 0 to 15:
            loop integers from 0 to 15:
                set {_lx} to loop-number-1
                set {_lz} to loop-number-2
                set {_wx} to {_baseX} + {_lx}
                set {_wz} to {_baseZ} + {_lz}

                set block at location({_wx}, {cavegen.floor} - 1, {_wz}, {_w}) to bedrock

                set {_open} to cavegen_is_air({_wx}, {_wz})

                # floor row is ALWAYS solid
                set block at location({_wx}, {cavegen.floor}, {_wz}, {_w}) to cavegen_block()

                # ceiling row is ALWAYS solid
                set block at location({_wx}, {cavegen.ceiling}, {_wz}, {_w}) to cavegen_block()

                # hollow out (or fill) everything strictly between floor and ceiling
                loop integers from ({cavegen.floor} + 1) to ({cavegen.ceiling} - 1):
                    set {_y} to loop-number-3
                    set {_loc} to location({_wx}, {_y}, {_wz}, {_w})
                    if {_open} is true:
                        set block at {_loc} to air
                    else:
                        set block at {_loc} to cavegen_block()

                # wipe out anything a player built above the cave band
                loop integers from ({cavegen.ceiling} + 1) to 120:
                    set block at location({_wx}, loop-number-3, {_wz}, {_w}) to air

        send "&a[CaveGen] Done! This chunk has a fresh cave layout." to player
        
command /caveworldregen:
    permission: cavegen.admin
    permission message: &cYou don't have permission to use this command.
    trigger:
        set {_w} to world {cavegen.world}

        # move everyone out first - unload fails if players are still inside
        loop all players in {_w}:
            teleport loop-player to spawn of world "world"
            send "&c[CaveGen] The cave world is being regenerated..." to loop-player

        send "&7[CaveGen] Unloading and deleting %{cavegen.world}%..." to player
        unload world {_w}
        wait 1 second
        delete world file for {cavegen.world}
        wait 1 second

        set {_new} to a world creator named {cavegen.world}
        set environment option of {_new} to normal
        set world type option of {_new} to normal
        set should generate structures option of {_new} to false
        set chunk generator of {_new} to chunk generator with id "cavegen"
        load world from creator {_new}

        send "&a[CaveGen] %{cavegen.world}% has been fully regenerated." to player
        
command /cavetp:
    permission: cavegen.use
    permission message: &cYou don't have permission to use this command.
    trigger:
        set {_w} to world {cavegen.world}
        set {_y} to {cavegen.ceiling} + 1
        teleport player to location(x-coord of player, {_y}, z-coord of player, {_w})
        send "&a[CaveGen] Teleported to the cave world." to player
on load:
    if world "main" is not loaded:
        set {_w} to world creator named "main"
        set chunk generator of {_w} to chunk generator with id "main"
        load world from creator {_w}

register chunk generator with id "main":
    noise gen:
        loop integers from 0 to 15:
            loop integers from 0 to 15:
                set {_x} to (loop-number-1)
                set {_z} to (loop-number-2)
                set {_n} to block noise at vector({_x} + (chunkdata chunk x * 16), 1, {_z} + (chunkdata chunk z * 16))
                set chunkdata blocks within vector({_x}, 0, {_z}) and vector({_x}, {_n}, {_z}) to stone[]
    surface gen:
        loop integers from 0 to 15:
            loop integers from 0 to 15:
                set {_x} to (loop-number-1)
                set {_z} to (loop-number-2)
                set {_y} to chunkdata highest block y at vector({_x}, 0, {_z})
                set chunkdata block at vector({_x}, {_y}, {_z}) to grass_block[]
                set chunkdata block at vector({_x}, {_y} - 1, {_z}) to dirt[]
                set chunkdata block at vector({_x}, {_y} - 2, {_z}) to dirt[]
    population gen:
        loop integers from 0 to 15:
            loop integers from 0 to 15:
                set {_x} to (loop-number-1)
                set {_z} to (loop-number-2)
                set {_y} to chunkdata highest block y at vector({_x}, 0, {_z})
                set {_chance} to random integer between 1 and 100
                if {_chance} <= 4:
                    set chunkdata block at vector({_x}, {_y} + 1, {_z}) to oak_log[]
                    set chunkdata block at vector({_x}, {_y} + 2, {_z}) to oak_log[]
                    set chunkdata block at vector({_x}, {_y} + 3, {_z}) to oak_leaves[]
                    set chunkdata block at vector({_x} + 1, {_y} + 3, {_z}) to oak_leaves[]
                    set chunkdata block at vector({_x} - 1, {_y} + 3, {_z}) to oak_leaves[]
                    set chunkdata block at vector({_x}, {_y} + 3, {_z} + 1) to oak_leaves[]
                    set chunkdata block at vector({_x}, {_y} + 3, {_z} - 1) to oak_leaves[]
                    set chunkdata block at vector({_x}, {_y} + 4, {_z}) to oak_leaves[]
                else if {_chance} <= 45:
                    set chunkdata block at vector({_x}, {_y} + 1, {_z}) to short_grass[]
                else if {_chance} <= 60:
                    set chunkdata block at vector({_x}, {_y} + 1, {_z}) to fern[]
    biome gen:
        set chunkdata biome to plains

command /worldreset:
    trigger:
        if world "main" is loaded:
            loop all players in world "main":
                teleport loop-player to spawn of world "world"
            unload world "main" with saving false
        wait 5 ticks
        set {_w} to world creator named "main"
        set chunk generator of {_w} to chunk generator with id "main"
        load world from creator {_w}
        wait 5 ticks
        teleport player to spawn of world "main"
        send "&aThe grassland has been reset and you've been teleported!" to player
        
command /worldtp:
    trigger:
        teleport player to spawn of world "main"
##########################################################################
# CAVEGEN — one big, connected, natural cave chunk generator
#
# REQUIRES:
#   - Skript
#   - SkBee            (chunk generator / world creator)  https://github.com/ShaneBeee/SkBee
#   - SkNoise 1.0+      (simplex noise "generator" objects) https://github.com/ReportCardsMC/SKNoise
#
# WHAT THIS DOES:
#   1. Registers a custom chunk generator ("cavegen") built from FOUR noise layers:
#        - a "zone" mask     -> very low frequency, marks ONE broad region
#                               where the cave is even allowed to exist.
#                               Outside it, everything is solid rock, which
#                               is what stops lots of small scattered caves
#                               from popping up all over the world.
#        - a floor-height map -> the ground rolls up and down per column
#        - a ceiling-height map -> the rock overhead rolls up and down too
#        - a 3D "carve" noise  -> hollows out one big, open, connected cave
#          system inside the zone (no flat rectangular pillars)
#      All solid material is a random mix of stone/andesite/cobblestone
#      (no ores). A minimum vertical gap is enforced so it's always tall
#      enough to walk through, and bedrock is always buried well below the
#      lowest possible floor so it's never visible.
#   2. Creates/loads a dedicated world ("cavegen_world") using that generator.
#      New chunks in that world generate using this cave layout automatically.
#
# TUNING (search for "TUNE" below):
#   - {cavegen.zoneFreq}     -> how large the single cave region is. LOWER = bigger single zone
#   - {cavegen.zoneThreshold}-> how much of that low-freq noise counts as "cave zone"
#   - {cavegen.freq}         -> interior cave noise "zoom" inside the zone. lower = bigger rooms
#   - {cavegen.threshold}    -> higher = more open/bigger caves inside the zone
#   - {cavegen.heightFreq}   -> how quickly floor/ceiling height rolls up and down
#   - {cavegen.floorBase}/{cavegen.floorVariance} -> average floor height + how much it varies
#   - {cavegen.ceilBase}/{cavegen.ceilVariance}   -> average ceiling height + how much it varies
#   - {cavegen.minGap}       -> minimum walkable vertical clearance, guaranteed
##########################################################################

on script load:
    # ---- tunables -------------------------------------------------------
    set {cavegen.zoneFreq} to 0.004            # TUNE: lower = one bigger single cave region
    set {cavegen.zoneThreshold} to 0.55         # TUNE: higher = more of the world is inside the cave zone

    set {cavegen.freq} to 0.016                # TUNE: interior cave carve noise zoom (lower = bigger rooms)
    set {cavegen.threshold} to 0.52             # TUNE: higher = bigger/more open caves

    set {cavegen.heightFreq} to 0.012           # TUNE: floor/ceiling roll speed (lower = smoother hills)

    set {cavegen.floorBase} to 55               # average floor height
    set {cavegen.floorVariance} to 5            # +/- how much the floor rolls
    set {cavegen.ceilBase} to 74                # average ceiling height
    set {cavegen.ceilVariance} to 6             # +/- how much the ceiling rolls
    set {cavegen.minGap} to 6                   # guaranteed minimum walkable height

    set {cavegen.globalMin} to {cavegen.floorBase} - {cavegen.floorVariance} - 1
    set {cavegen.globalMax} to {cavegen.ceilBase} + {cavegen.ceilVariance} + 1

    set {cavegen.world} to "cavegen_world"

    # ---- noise generators (shared by world-gen AND the /cavegen command) -
    set {cavegen.zoneNoise} to new simplex generator with seed 555111
    set frequency of {cavegen.zoneNoise} to {cavegen.zoneFreq}

    set {cavegen.noise} to new simplex generator with seed 918273645
    set frequency of {cavegen.noise} to {cavegen.freq}

    set {cavegen.floorNoise} to new simplex generator with seed 123456
    set frequency of {cavegen.floorNoise} to {cavegen.heightFreq}

    set {cavegen.ceilNoise} to new simplex generator with seed 987654
    set frequency of {cavegen.ceilNoise} to {cavegen.heightFreq}

    # ---- create/load the cave world if it doesn't exist yet -------------
    if world {cavegen.world} is not loaded:
        set {_w} to a world creator named {cavegen.world}
        set environment option of {_w} to normal
        set world type option of {_w} to normal
        set should generate structures option of {_w} to false
        set chunk generator of {_w} to chunk generator with id "cavegen"
        load world from creator {_w}
        send "&a[CaveGen] Cave world &f%{cavegen.world}%&a generated." to console

##########################################################################
# SHARED LOGIC
##########################################################################

# Is this x/z inside the one broad region where the cave is allowed to exist?
function cavegen_in_zone(x: number, z: number) :: boolean:
    set {_raw} to value of {cavegen.zoneNoise} at {_x}, 0, {_z}
    set {_v} to abs({_raw})
    if {_v} < {cavegen.zoneThreshold}:
        return true
    return false

# Local floor height at this x/z (rolls around {cavegen.floorBase})
function cavegen_floor_y(x: number, z: number) :: number:
    set {_v} to value of {cavegen.floorNoise} at {_x}, 0, {_z}
    return round({cavegen.floorBase} + ({_v} * {cavegen.floorVariance}))

# Local ceiling height at this x/z (rolls around {cavegen.ceilBase}),
# clamped so there's always at least {cavegen.minGap} of walkable space
function cavegen_ceiling_y(x: number, z: number, floory: number) :: number:
    set {_v} to value of {cavegen.ceilNoise} at {_x}, 0, {_z}
    set {_c} to round({cavegen.ceilBase} + ({_v} * {cavegen.ceilVariance}))
    if {_c} < ({_floory} + {cavegen.minGap}):
        set {_c} to {_floory} + {cavegen.minGap}
    return {_c}

# Interior carve noise (only meaningful when already inside the cave zone)
function cavegen_is_air(x: number, y: number, z: number) :: boolean:
    set {_raw} to value of {cavegen.noise} at {_x}, {_y}, {_z}
    set {_v} to abs({_raw})
    if {_v} < {cavegen.threshold}:
        return true
    return false

# Picks a random "no ores" mix for solid cave stone
function cavegen_block() :: blockdata:
    set {_r} to random integer between 1 and 100
    if {_r} <= 40:
        return stone[]
    else if {_r} <= 70:
        return andesite[]
    else:
        return cobblestone[]

##########################################################################
# CHUNK GENERATOR REGISTRATION (used for brand-new chunks in the world)
##########################################################################

register chunk generator with id "cavegen":

    noise gen:
        loop integers from 0 to 15:                       # local x  -> loop-number-1
            loop integers from 0 to 15:                   # local z  -> loop-number-2
                set {_lx} to loop-number-1
                set {_lz} to loop-number-2

                set {_wx} to {_lx} + (chunkdata chunk x * 16)
                set {_wz} to {_lz} + (chunkdata chunk z * 16)

                set {_fy} to cavegen_floor_y({_wx}, {_wz})
                set {_cy} to cavegen_ceiling_y({_wx}, {_wz}, {_fy})
                set {_inZone} to cavegen_in_zone({_wx}, {_wz})

                loop integers from {cavegen.globalMin} to {cavegen.globalMax}:
                    set {_y} to loop-number-3

                    if {_y} = {cavegen.globalMin}:
                        # always buried under solid ground - never exposed
                        set chunkdata block at vector({_lx}, {_y}, {_lz}) to bedrock
                    else if {_y} < {_fy}:
                        set chunkdata block at vector({_lx}, {_y}, {_lz}) to cavegen_block()
                    else if {_y} = {_fy}:
                        set chunkdata block at vector({_lx}, {_y}, {_lz}) to cavegen_block()
                    else if {_y} > {_cy}:
                        set chunkdata block at vector({_lx}, {_y}, {_lz}) to cavegen_block()
                    else if {_y} = {_cy}:
                        set chunkdata block at vector({_lx}, {_y}, {_lz}) to cavegen_block()
                    else if {_inZone} is false:
                        # outside the single cave region - solid rock, no cave here
                        set chunkdata block at vector({_lx}, {_y}, {_lz}) to cavegen_block()
                    else:
                        # interior of the cave zone: 3D noise carve -> one big, connected cave
                        if cavegen_is_air({_wx}, {_y}, {_wz}) is true:
                            set chunkdata block at vector({_lx}, {_y}, {_lz}) to air
                        else:
                            set chunkdata block at vector({_lx}, {_y}, {_lz}) to cavegen_block()

    biome gen:
        # Closest vanilla biome to a hypixel-style mine/cavern
        set chunkdata biome to dripstone caves
        
command /caveworldregen:
    permission: cavegen.admin
    permission message: &cYou don't have permission to use this command.
    trigger:
        set {_w} to world {cavegen.world}

        # move everyone out first - unload fails if players are still inside
        loop all players in {_w}:
            teleport loop-player to spawn of world "world"
            send "&c[CaveGen] The cave world is being regenerated..." to loop-player

        send "&7[CaveGen] Unloading and deleting %{cavegen.world}%..." to player
        unload world {_w}
        wait 1 second
        delete world file for {cavegen.world}
        wait 1 second

        set {_new} to a world creator named {cavegen.world}
        set environment option of {_new} to normal
        set world type option of {_new} to normal
        set should generate structures option of {_new} to false
        set chunk generator of {_new} to chunk generator with id "cavegen"
        load world from creator {_new}

        send "&a[CaveGen] %{cavegen.world}% has been fully regenerated." to player
        
command /cavetp:
    permission: cavegen.use
    permission message: &cYou don't have permission to use this command.
    trigger:
        set {_w} to world {cavegen.world}
        set {_y} to {cavegen.ceiling} + 1
        teleport player to location(x-coord of player, {_y}, z-coord of player, {_w})
        send "&a[CaveGen] Teleported to the cave world." to player
on place of lime concrete:
    cancel event
    if block below event-block is gray stained glass:
        if size of {gen1::%player%::*} >= 20:
            send "&cYou can only have &e20 generators active&7 at once!" to player
            stop
        remove 1 lime concrete from player
        set {_loc} to location of block below event-block
        set block at {_loc} to lime concrete
        add {_loc} to {gen1::%player%::*}
        set {gen1-owner::%{_loc}%} to player
    else:
        send "&cYou can only place generators on &egray stained glass&7!" to player
        stop

on right click on lime concrete:
    set {_loc} to location of event-block
    if {gen1-owner::%{_loc}%} is player:
        cancel event
        set event-block to gray stained glass
        give player 1 lime concrete
        loop {gen1::%player%::*}:
            if loop-value is {_loc}:
                delete {gen1::%player%::%loop-index%}
        delete {gen1-owner::%{_loc}%}
        delete {gen1-paper::%{_loc}%}

on place of red concrete:
    cancel event
    if block below event-block is gray stained glass:
        if size of {gen2::%player%::*} >= 10:
            send "&cYou can only have &e10 tier 2 generators active&7 at once!" to player
            stop
        remove 1 red concrete from player
        set {_loc} to location of block below event-block
        set block at {_loc} to red concrete
        add {_loc} to {gen2::%player%::*}
        set {gen2-owner::%{_loc}%} to player
    else:
        send "&cYou can only place generators on &egray stained glass&7!" to player
        stop

on right click on red concrete:
    set {_loc} to location of event-block
    if {gen2-owner::%{_loc}%} is player:
        cancel event
        set event-block to gray stained glass
        give player 1 red concrete
        loop {gen2::%player%::*}:
            if loop-value is {_loc}:
                delete {gen2::%player%::%loop-index%}
        delete {gen2-owner::%{_loc}%}
        delete {gen2-paper::%{_loc}%}

command /cleargenall:
    trigger:
        send "&aYou have created all generators." to player
        loop all players:
            clearPlacements(loop-player)
            send "&aAll your &egenerators &7have been reverted by Admin." to loop-player

command /cleargen <player>:
    trigger:
        clearPlacements(arg-1)
        send "&aAll your hidden generators have been reverted." to arg-1

function clearPlacements(p: player):
    loop {gen1::%{_p}%::*}:
        set {_loc} to loop-value
        set block at {_loc} to gray stained glass
        delete {gen1-owner::%{_loc}%}
        delete {gen1-paper::%{_loc}%}
    delete {gen1::%{_p}%::*}
    loop {gen2::%{_p}%::*}:
        set {_loc} to loop-value
        set block at {_loc} to gray stained glass
        delete {gen2-owner::%{_loc}%}
        delete {gen2-paper::%{_loc}%}
    delete {gen2::%{_p}%::*}


function makeMoney(money: number) :: item:
    set {_item} to paper named "&6$%{_money}%"
    set number data tag "money:value" of {_item} to {_money}
    return {_item}

every 1 second in "world":
    loop all players:
        loop {gen1::%loop-player%::*}:
            set {_loc} to loop-value-2
            set {_spawnLoc} to location 1 above {_loc}
            if {gen1-paper::%{_loc}%} is set:
                if {gen1-paper::%{_loc}%} is alive:
                    set {_val} to number data tag "money:value" of item of {gen1-paper::%{_loc}%}
                    add 1 to {_val}
                    set item of {gen1-paper::%{_loc}%} to makeMoney({_val})
                else:
                    delete {gen1-paper::%{_loc}%}
            else:
                drop makeMoney(1) at {_spawnLoc} without velocity
                set {gen1-paper::%{_loc}%} to last dropped item
                set gravity of {gen1-paper::%{_loc}%} to false

        loop {gen2::%loop-player%::*}:
            set {_loc} to loop-value-2
            set {_spawnLoc} to location 1 above {_loc}
            if {gen2-paper::%{_loc}%} is set:
                if {gen2-paper::%{_loc}%} is alive:
                    set {_val} to number data tag "money:value" of item of {gen2-paper::%{_loc}%}
                    add 10 to {_val}
                    set item of {gen2-paper::%{_loc}%} to makeMoney({_val})
                else:
                    delete {gen2-paper::%{_loc}%}
            else:
                drop makeMoney(10) at {_spawnLoc} without velocity
                set {gen2-paper::%{_loc}%} to last dropped item
                set gravity of {gen2-paper::%{_loc}%} to false

on pickup:
    if event-item is paper:
        set {_value} to number data tag "money:value" of event-item
        if {_value} is set:
            GainMoney(player, {_value})
            cancel event
            delete event-dropped item